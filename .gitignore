# =============================================================================
# GlobeLens AI — .gitignore
# =============================================================================

# ── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.egg
pip-log.txt

# ── Alembic ───────────────────────────────────────────────────────────────────
# (Keep alembic/versions/ tracked, but exclude local state)
backend/alembic.ini.local

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build cache. Regenerated on every `tsc`/`next build`
# and was previously tracked, so each build produced spurious diff noise.
*.tsbuildinfo

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml tracked; ignore override
docker-compose.override.yml

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

