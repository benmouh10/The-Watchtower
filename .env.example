# =============================================================================
# GlobeLens AI — Environment Variables Template
# =============================================================================
# Instructions:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in secrets   (never commit the .env file to version control)
#   3. Run:              docker-compose up --build
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development

# REQUIRED. JWT signing is symmetric, so this value alone is enough to mint a
# valid access token for any user (including an admin role). Generate a fresh
# one rather than editing the placeholder below:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# There is deliberately no default in docker-compose.yml either. With
# APP_ENV=production and the placeholder still in place, the app refuses to
# start rather than silently signing tokens with a public key.
SECRET_KEY=CHANGE_ME_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Development-only escape hatch for booting a non-production box with the
# placeholder. Has no effect when APP_ENV=production.
ALLOW_INSECURE_DEV_SECRET=false

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
POSTGRES_USER=globelens
POSTGRES_PASSWORD=globelens_secret
POSTGRES_DB=globelens_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://globelens:globelens_secret@db:5432/globelens_db

# ── Redis Stack ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret@cache:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://search:9200
ELASTICSEARCH_INDEX_EVENTS=globelens_events

# ── LLM Providers ────────────────────────────────────────────────────────────
# Choose one: nvidia | azure | grok | gemini
LLM_PROVIDER=nvidia
EMBEDDING_PROVIDER=azure
AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
AZURE_EMBEDDING_ENDPOINT=https://your_azure_embedding_endpoint_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
TAVILY_API_KEY=your_tavily_api_key_here

# ── External Fact-Check ───────────────────────────────────────────────────────
# Leave FACTCHECK_PROVIDER empty to disable external fact-check lookups (claims
# then keep honest nulls for reviewed_by / review_url). Set to "google" and add
# a Google Cloud API key with the Fact Check Tools API enabled to surface real
# third-party reviews on analysed claims.
FACTCHECK_PROVIDER=
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
FACTCHECK_MAX_LOOKUPS_PER_REQUEST=5
FACTCHECK_TIMEOUT_SECONDS=10

# ── Real-Time Feeds ───────────────────────────────────────────────────────────
# SSE live feed announcing events the moment they reach PROCESSED. Default ON
# (Redis pub/sub, idle unless a client is connected).
REALTIME_ENABLED=true
REALTIME_EVENT_CHANNEL=globelens:events:new

# ── Notifications / Web Push ──────────────────────────────────────────────────
# In-app notifications are delivered through the browser's push service.
# PUSH_ENABLED=false (the default) runs the honest log-mode sender: digest
# pushes are captured to the log and marked 'logged', never claimed as sent.
# To actually reach browsers, set PUSH_ENABLED=true AND supply a complete VAPID
# keypair + contact (all three, or the app refuses to guess). Generate a keypair
# with:  python -c "from py_vapid import generate_vapid_keys; k=generate_vapid_keys(); print(k.public_key.export_pem().decode()); print(k.rsa.export_key().decode())"
# APP_BASE_URL is the origin used for deep-link URLs inside push payloads.
PUSH_ENABLED=false
# PUSH_POLL_SECONDS=60
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:ops@example.com
# PUSH_SUBJECT=GlobeLens AI
# APP_BASE_URL=http://localhost:3000

# ── Digests & Newsletter ──────────────────────────────────────────────────────
# Daily "comprehensive brief" digests and the email newsletter delivery queue.
# Both are config-gated like push: with EMAIL_ENABLED=false deliveries are
# logged, honest about never having been sent. To actually email, set
# EMAIL_ENABLED=true AND provide an SMTP relay (the sender refuses to guess).
# EMAIL_POLL_SECONDS is the background drain cadence for pending deliveries.
# APP_BASE_URL is the origin used to build the one-click unsubscribe link in the
# email body (e.g. http://localhost:3000).
DIGEST_ENABLED=false
# DIGEST_CRON=0 6 * * *
# DIGEST_MAX_EVENTS=10
# DIGEST_LOOKBACK_HOURS=24
# EMAIL_ENABLED=false
# EMAIL_POLL_SECONDS=60
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_STARTTLS=true
# EMAIL_FROM_EMAIL=newsletter@example.com
# APP_BASE_URL=http://localhost:3000


# ── Public API & Rate Limits ──────────────────────────────────────────────────
# `glb_` API keys (self-serve under /api/v1/api-keys) authenticate the
# otherwise-anonymous read surface (/events, /sources, /digests, /search) and
# are metered as `api_request` usage rows. Keys are scoped, so a key can carry
# only the read scopes it was minted with (read:events, read:sources, …).
# The sliding-window rate limiter and plan quotas are off by default; gate on
# them before exposing the stack beyond localhost.
# ENFORCE_RATE_LIMITS=false
# API_DAILY_LIMIT=1000
# API_DAILY_LIMIT_PRO=10000
# ENFORCE_PLAN_QUOTAS=false

# ── Embedding Model ───────────────────────────────────────────────────────────
# OpenAI embedding model used by EmbeddingService
EMBEDDING_MODEL=text-embedding-3-small

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GlobeLens AI

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
